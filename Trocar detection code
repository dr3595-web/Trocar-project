// PURPOSE: HX711 calibration finder for offset and scale
//     URL: https://github.com/RobTillaart/HX711


#include "HX711.h"

HX711 myScale;

uint8_t dataPin = 4;
uint8_t clockPin = 5;

bool calibrated = false;

//  for stability detection
float lastWeight = 0;
unsigned long stableStart = 0;
const float STABLE_TOLERANCE = 1.0;      //  grams of allowed jitter
const unsigned long STABLE_TIME = 1500;  //  ms it must hold steady


void setup()
{
  Serial.begin(115200);
  Serial.println();
  Serial.println(__FILE__);
  Serial.print("HX711_LIB_VERSION: ");
  Serial.println(HX711_LIB_VERSION);
  Serial.println();

  myScale.begin(dataPin, clockPin);
}

void loop()
{
  if (!calibrated)
  {
    calibrate();
    calibrated = true;
  }
  else
  {
    measure();
  }
}


void calibrate()
{
  Serial.println("\n\nCALIBRATION\n===========");
  Serial.println("remove all weight from the loadcell, then press enter");
  while (Serial.available()) Serial.read();
  while (Serial.available() == 0);
  while (Serial.available()) Serial.read();

  Serial.println("letting loadcell settle (5s)...");
  delay(5000);   //  longer settle time to let creep recover before taring

  myScale.tare(20);

  Serial.println("place your reference weight, then enter grams and press enter");
  while (Serial.available()) Serial.read();

  uint32_t weight = 0;
  while (Serial.peek() != '\n')
  {
    if (Serial.available())
    {
      char ch = Serial.read();
      if (isdigit(ch)) weight = weight * 10 + (ch - '0');
    }
  }
  while (Serial.available()) Serial.read();

  Serial.println("letting loadcell settle (3s)...");
  delay(3000);

  myScale.calibrate_scale(weight, 20);
  float scale = myScale.get_scale();

  Serial.print("SCALE FACTOR: ");
  Serial.println(scale, 6);
  Serial.println("\nCalibration done. Measuring now (waits for reading to stabilize).");
  Serial.println("Type 'r' + enter to redo.\n");
  while (Serial.available()) Serial.read();

  lastWeight = 0;
  stableStart = millis();
}


void measure()
{
  if (Serial.available())
  {
    char ch = Serial.read();
    if (ch == 'r')
    {
      while (Serial.available()) Serial.read();
      calibrated = false;
      return;
    }
  }

  if (!myScale.is_ready()) return;

  float weight = myScale.get_units(4);

  if (abs(weight - lastWeight) > STABLE_TOLERANCE)
  {
    //  still moving/settling - reset the stability timer
    stableStart = millis();
    lastWeight = weight;
    return;
  }

  //  holding steady - only print once it's been stable for STABLE_TIME
  if (millis() - stableStart >= STABLE_TIME)
  {
    Serial.print("WEIGHT: ");
    Serial.println(weight, 1);
    stableStart = millis();   //  avoid spamming, print roughly once per stable window
  }
}
